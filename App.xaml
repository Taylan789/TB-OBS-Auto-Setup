<Application x:Class="TB_OBS_AutoSetup.App" StartupUri="MainWindow.xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#0A0D12"/><SolidColorBrush x:Key="Panel" Color="#111722"/><SolidColorBrush x:Key="Panel2" Color="#171E2B"/><SolidColorBrush x:Key="Accent" Color="#65FF7A"/><SolidColorBrush x:Key="Purple" Color="#9D7CFF"/><SolidColorBrush x:Key="Text" Color="#F3F6FA"/><SolidColorBrush x:Key="Muted" Color="#93A0B2"/><SolidColorBrush x:Key="Border" Color="#263142"/>
    <Style TargetType="Button"><Setter Property="Background" Value="{StaticResource Panel2}"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="4"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#0C1119"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="4"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Background" Value="#0C1119"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="4"/></Style>
  </Application.Resources>
</Application>
