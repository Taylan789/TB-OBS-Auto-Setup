<Application x:Class="TB_OBS_AutoSetup.App"
             StartupUri="MainWindow.xaml"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#090C12"/>
    <SolidColorBrush x:Key="Surface" Color="#101620"/>
    <SolidColorBrush x:Key="Surface2" Color="#151D29"/>
    <SolidColorBrush x:Key="Surface3" Color="#1B2533"/>
    <SolidColorBrush x:Key="Accent" Color="#69FF78"/>
    <SolidColorBrush x:Key="Purple" Color="#9C7BFF"/>
    <SolidColorBrush x:Key="Text" Color="#F5F7FA"/>
    <SolidColorBrush x:Key="Muted" Color="#9AA7B8"/>
    <SolidColorBrush x:Key="Border" Color="#273345"/>
    <SolidColorBrush x:Key="Danger" Color="#FF6B78"/>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Surface3}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0B1119"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="#0B1119"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Margin" Value="4"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="16,10"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Padding" Value="8,7"/>
      <Setter Property="Margin" Value="2"/>
    </Style>
  </Application.Resources>
</Application>
