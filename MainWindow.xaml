<Window x:Class="TB_OBS_AutoSetup.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="TB OBS Auto Setup V9 • One-Click Live Center" Width="1500" Height="940" MinWidth="1200" MinHeight="780"
 WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal">
    <Border Width="52" Height="52" CornerRadius="15" Background="#14261D" BorderBrush="#2B6B49" BorderThickness="1"><TextBlock Text="TB" Foreground="{StaticResource GreenBrush}" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <StackPanel Margin="14,0,0,0"><TextBlock Text="TB OBS AUTO SETUP" Foreground="{StaticResource TextBrush}" FontSize="27" FontWeight="Bold"/><TextBlock Text="Hazırla • kontrol et • onayla • canlı yayına geç" Foreground="{StaticResource MutedBrush}" FontSize="12"/></StackPanel>
   </StackPanel>
   <StackPanel Grid.Column="1"><TextBlock Text="V9 ONE-CLICK LIVE CENTER" Foreground="{StaticResource GreenBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/><TextBlock x:Name="ConnectionText" Text="● OBS BAĞLI DEĞİL" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Right" Margin="0,4,0,0"/></StackPanel>
  </Grid>

  <Grid Grid.Row="1" Margin="0,18,0,16">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0"><StackPanel><TextBlock Text="CPU" Style="{StaticResource CardLabel}"/><TextBlock x:Name="CpuCard" Text="—" Style="{StaticResource CardValue}"/></StackPanel></Border>
   <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="6,0"><StackPanel><TextBlock Text="GPU" Style="{StaticResource CardLabel}"/><TextBlock x:Name="GpuCard" Text="—" Style="{StaticResource CardValue}"/></StackPanel></Border>
   <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="6,0"><StackPanel><TextBlock Text="RAM" Style="{StaticResource CardLabel}"/><TextBlock x:Name="RamCard" Text="—" Style="{StaticResource CardValue}"/></StackPanel></Border>
   <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="6,0"><StackPanel><TextBlock Text="ENCODER" Style="{StaticResource CardLabel}"/><TextBlock x:Name="EncoderCard" Text="—" Foreground="{StaticResource GreenBrush}" FontSize="13" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border>
   <Border Grid.Column="4" Style="{StaticResource CardStyle}" Margin="6,0"><StackPanel><TextBlock Text="BITRATE" Style="{StaticResource CardLabel}"/><TextBlock x:Name="BitrateCard" Text="—" Foreground="{StaticResource PurpleBrush}" FontSize="13" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border>
   <Border Grid.Column="5" Style="{StaticResource CardStyle}" Margin="6,0,0,0"><StackPanel><TextBlock Text="OBS HEALTH" Style="{StaticResource CardLabel}"/><TextBlock x:Name="HealthCard" Text="BEKLENİYOR" Foreground="{StaticResource AmberBrush}" FontSize="13" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border>
  </Grid>

  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="15" Padding="17" Margin="0,0,12,0">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="CONTROL CENTER" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="Bold"/>
     <TextBlock x:Name="PlanText" Text="Sistem hazır" Foreground="{StaticResource GreenBrush}" FontSize="12" Margin="0,5,0,16"/>
     <Button Content="1  •  SİSTEM ANALİZİ" Click="Analyze_Click"/>
     <Button Content="2  •  OBS'Yİ BAŞLAT" Click="LaunchObs_Click"/>
     <Button Content="3  •  OBS'YE BAĞLAN" Click="Connect_Click"/>
     <Button Content="4  •  TEK TIK: HAZIRLA + CANLIYA GEÇ" Click="PrepareAndGoLive_Click" Background="#FF5570" Foreground="#17080C" BorderBrush="#FF5570" Height="46" FontSize="12"/>
     <Button Content="SADECE YAYINA HAZIRLA" Click="Optimize_Click" Background="#39FF88" Foreground="#07120B" BorderBrush="#39FF88" Height="38"/>
     <Button Content="YAYINI BAŞLAT (HAZIRLIK KONTROLÜYLE)" Click="GoLive_Click" Background="#342018" Foreground="#FFB84D" BorderBrush="#805C35" Height="38"/>
     <Button Content="YAYINI DURDUR" Click="StopLive_Click" Background="#21151A" Foreground="{StaticResource DangerBrush}" BorderBrush="#63303C" Height="34"/>
     <CheckBox x:Name="RecordAlongsideCheckBox" Content="Yayınla birlikte yerel kayıt başlat (MKV)" IsChecked="False" Foreground="{StaticResource TextBrush}" Margin="0,3,0,3"/>
     <CheckBox x:Name="ReplayBufferAlongsideCheckBox" Content="Yayın başlayınca Replay Buffer'ı aç" IsChecked="False" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10" ToolTip="Replay Buffer OBS'de etkin olmalı; başlatılamazsa yayını durdurmaz."/>
     <Separator Margin="0,8"/>
     <TextBlock Text="YAYIN KAYNAĞI" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
     <TextBlock Text="Kaynak türü" Foreground="{StaticResource TextBrush}" FontSize="11" Margin="0,7,0,4"/>
     <ComboBox x:Name="SourceModeBox" SelectedIndex="1" SelectionChanged="SetupSelection_Changed">
      <ComboBoxItem Content="PC oyunu (Game Capture)"/>
      <ComboBoxItem Content="PS5 / HDMI yakalama kartı"/>
     </ComboBox>
     <TextBlock Text="Yakalama kartı cihazı" Foreground="{StaticResource TextBrush}" FontSize="11" Margin="0,7,0,4"/>
     <ComboBox x:Name="CaptureDeviceBox" SelectionChanged="SetupSelection_Changed" ToolTip="OBS'nin bulduğu görüntü cihazlarından HDMI capture kartını seç."/>
     <TextBlock Text="Webcam cihazı (isteğe bağlı)" Foreground="{StaticResource TextBrush}" FontSize="11" Margin="0,7,0,4"/>
     <ComboBox x:Name="CameraDeviceBox" SelectionChanged="SetupSelection_Changed" ToolTip="Kamerayı seç; kaynak özellikleri OBS önizlemesinde kontrol edilmeli."/>
     <TextBlock Text="Mikrofon cihazı (global mikrofon yoksa)" Foreground="{StaticResource TextBrush}" FontSize="11" Margin="0,7,0,4"/>
     <ComboBox x:Name="MicrophoneDeviceBox" SelectionChanged="SetupSelection_Changed" ToolTip="OBS global mikrofon tanımlı değilse kullanılacak cihaz."/>
     <TextBlock Text="Masaüstü ses cihazı (global ses yoksa)" Foreground="{StaticResource TextBrush}" FontSize="11" Margin="0,7,0,4"/>
     <ComboBox x:Name="DesktopAudioDeviceBox" SelectionChanged="SetupSelection_Changed" ToolTip="OBS global desktop audio tanımlı değilse kullanılacak cihaz."/>
     <Separator Margin="0,8"/>
     <TextBlock Text="YAYIN PROFİLİ" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
     <TextBlock Text="Bitrate profili (OBS yayın hedefini değiştirmez)" Foreground="{StaticResource TextBrush}" FontSize="11" Margin="0,7,0,4"/>
     <ComboBox x:Name="PlatformBox" SelectedIndex="0" SelectionChanged="Platform_Changed"><ComboBoxItem Content="Kick"/><ComboBoxItem Content="YouTube"/><ComboBoxItem Content="Twitch"/><ComboBoxItem Content="Özel / Manual"/></ComboBox>
     <TextBlock Text="Platform profili yalnızca bitrate öneri sınırını etkiler. Yayın hedefine aşağıdaki isteğe bağlı RTMP ayarlarıyla geçebilir veya OBS'de kayıtlı servisi kullanabilirsin." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,2"/>
     <CheckBox x:Name="UseCustomRtmpCheckBox" Content="Tek tuşta aşağıdaki RTMP hedefini uygula" IsChecked="False" Foreground="{StaticResource GreenBrush}" Margin="0,7,0,4" Checked="CustomRtmp_Changed" Unchecked="CustomRtmp_Changed"/>
     <TextBlock Text="RTMP sunucu adresi (platform yayın panelinden)" Foreground="{StaticResource TextBrush}" FontSize="11" Margin="0,3,0,4"/>
     <TextBox x:Name="StreamServerBox" Text="" ToolTip="Örn. rtmp://sunucu-adresi/live veya rtmps://..." TextChanged="CustomRtmp_Changed"/>
     <TextBlock Text="Yayın anahtarı (sadece sen girersen kullanılır)" Foreground="{StaticResource TextBrush}" FontSize="11" Margin="0,7,0,4"/>
     <PasswordBox x:Name="StreamKeyBox" ToolTip="Anahtar log, tanılama raporu veya uygulama yedeğine yazılmaz." PasswordChanged="CustomRtmp_Changed"/>
     <TextBlock Text="RTMP kutusu seçiliyse iki alan da zorunludur. Uygulama anahtarı yalnızca OBS'ye ayarlamak için kullanır; OBS kendi yayın hedefini normal şekilde kaydeder. Kutuyu seçmezsen mevcut OBS hedefi korunur." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,2"/>
     <TextBlock Text="Çözünürlük" Foreground="{StaticResource TextBrush}" FontSize="11" Margin="0,7,0,4"/>
     <ComboBox x:Name="ResolutionBox" SelectedIndex="0" SelectionChanged="SetupSelection_Changed"><ComboBoxItem Content="1920x1080"/><ComboBoxItem Content="1664x936"/><ComboBoxItem Content="1280x720"/></ComboBox>
     <TextBlock Text="FPS" Foreground="{StaticResource TextBrush}" FontSize="11" Margin="0,7,0,4"/>
     <ComboBox x:Name="FpsBox" SelectedIndex="0" SelectionChanged="SetupSelection_Changed"><ComboBoxItem Content="60"/><ComboBoxItem Content="30"/></ComboBox>
     <TextBlock Text="Upload (Mbps)" Foreground="{StaticResource TextBrush}" FontSize="11" Margin="0,7,0,4"/>
     <TextBox x:Name="UploadBox" Text="" ToolTip="Upload test sonucu veya internet hızını elle yazabilirsin."/>
     <Button Content="BITRATE ÖNERİSİ HESAPLA" Click="Bitrate_Click" Margin="0,7,0,0"/>
     <TextBlock x:Name="BitrateRecommendation" Text="Öneri: upload testi yap." Foreground="{StaticResource GreenBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8"/>
     <Separator Margin="0,8"/>
     <TextBlock Text="DİAGNOSTIC" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
     <Button Content="UPLOAD HIZ TESTİ" Click="UploadTest_Click"/>
     <Button Content="OBS HEALTH TARAMASI" Click="Health_Click"/>
     <Button Content="5 SANİYE PERFORMANS TESTİ" Click="Performance_Click"/>
     <Button Content="SAHNE / KAYNAK ENVANTERİ" Click="Inventory_Click"/>
     <Button Content="TANILAMA RAPORUNU DIŞA AKTAR" Click="ExportDiagnostic_Click"/>
     <Button Content="REPLAY BUFFER'I BAŞLAT" Click="Replay_Click"/>
     <Separator Margin="0,8"/>
     <TextBlock Text="YEDEK / KURTARMA" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
     <Button Content="BACKUP KLASÖRÜNÜ AÇ" Click="OpenBackup_Click"/>
     <Button Content="SON YEDEĞİ GERİ YÜKLE" Click="Rollback_Click" Background="#21151A" Foreground="{StaticResource DangerBrush}" BorderBrush="#63303C"/>
     <Separator Margin="0,8"/>
     <TextBlock Text="OBS WEBSOCKET" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
     <Grid Margin="0,7,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="84"/></Grid.ColumnDefinitions>
      <TextBox x:Name="HostBox" Text="127.0.0.1" ToolTip="OBS WebSocket sunucu adresi"/>
      <TextBox x:Name="PortBox" Grid.Column="1" Text="4455" Margin="8,0,0,0" ToolTip="Varsayılan port: 4455"/>
     </Grid>
     <PasswordBox x:Name="PasswordBox" Margin="0,7,0,0"/>
     <TextBlock Text="OBS 28+ • Varsayılan 127.0.0.1:4455" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0"/>
     <TextBlock Text="WebSocket şifresi sadece bağlantı için bellekte kullanılır. OBS içindeki yayın anahtarı okunmaz. İsteğe bağlı RTMP anahtarını sen girersen yalnızca OBS’ye gönderilir; log, tanılama raporu ve uygulama yedeğine yazılmaz. OBS kendi yayın ayarı olarak saklar." Foreground="{StaticResource TextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
    </StackPanel></ScrollViewer>
   </Border>

   <Grid Grid.Column="1">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="190"/></Grid.RowDefinitions>
    <TabControl Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}">
     <TabItem Header="DASHBOARD"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal"><TextBlock Text="PROFESSIONAL DASHBOARD" Foreground="{StaticResource TextBrush}" FontSize="19" FontWeight="Bold"/><TextBlock Text="  •  canlı kontrol" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/></StackPanel>
      <Grid Grid.Row="1" Margin="0,15,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource InnerCard}" Margin="0,0,8,8"><StackPanel><TextBlock Text="STREAM PROFILE" Style="{StaticResource CardLabel}"/><TextBlock x:Name="ProfileText" Text="1080p60" Foreground="{StaticResource TextBrush}" FontSize="22" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock x:Name="ProfileDetail" Text="Advanced Output" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></Border>
       <Border Grid.Column="1" Style="{StaticResource InnerCard}" Margin="8,0,0,8"><StackPanel><TextBlock Text="SCENES" Style="{StaticResource CardLabel}"/><TextBlock x:Name="SceneCountText" Text="—" Foreground="{StaticResource GreenBrush}" FontSize="28" FontWeight="Bold" Margin="0,6,0,0"/><TextBlock Text="TB OYUN • JUST CHATTING • START • BRB • END" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap"/></StackPanel></Border>
       <Border Grid.Row="1" Style="{StaticResource InnerCard}" Margin="0,8,8,0"><StackPanel><TextBlock Text="AUDIO" Style="{StaticResource CardLabel}"/><TextBlock Text="MIC → SUPPRESS → COMPRESS → EXPAND" Foreground="{StaticResource TextBrush}" FontWeight="Bold" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock Text="Filtreler OBS destekliyorsa otomatik denenir." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/></StackPanel></Border>
       <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource InnerCard}" Margin="8,8,0,0"><StackPanel><TextBlock Text="HEALTH SNAPSHOT" Style="{StaticResource CardLabel}"/><TextBlock x:Name="StatsText" Text="FPS — • Render — • Dropped —" Foreground="{StaticResource TextBrush}" FontWeight="Bold" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock x:Name="ReadinessText" Text="Yayın ön kontrolü henüz yapılmadı." Foreground="{StaticResource AmberBrush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock Text="GetStats üzerinden canlı veriler." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/></StackPanel></Border>
      </Grid>
     </Grid></TabItem>
     <TabItem Header="LOG"><Grid Margin="18"><TextBox x:Name="LogBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/></Grid></TabItem>
     <TabItem Header="WHAT'S NEW"><ScrollViewer Margin="20"><StackPanel><TextBlock Text="V9 ONE-CLICK LIVE CENTER" FontSize="26" FontWeight="Bold" Foreground="{StaticResource GreenBrush}"/><TextBlock Text="• Tek tuşla hazırlık + onayla canlıya geçiş&#10;• PC Game Capture veya PS5 HDMI capture kartı modu&#10;• Gerçek cihaz listeleri ve seçimleri&#10;• İsteğe bağlı kullanıcı girişiyle Custom RTMP hedefi ayarlanabilir; anahtar log/rapor/yedeğe yazılmaz&#10;• Yayın aktifliği doğrulanana kadar bekleme&#10;• Yayın yanında isteğe bağlı MKV kayıt ve Replay Buffer&#10;• OBS kaynak türlerinin sürümlü kimliklerine uyumlu eşleştirme&#10;• Yanlış türde mevcut kaynak sahneye bağlanmaz&#10;• Kaynak oluşturma sonrası OBS envanter doğrulaması&#10;• Düşük upload'ta bitrate'i zorlamama&#10;• Kullanıcının base canvas ölçüsünü koruma&#10;• Encoder kimliğini GPU adına bakarak değiştirmeme&#10;• Çıkış durumu okunamazsa güvenli durma&#10;• Global desktop/mic sesini scene item gibi eklememe&#10;• service.json hariç güvenli yedek + rollback&#10;• Yerel tanılama raporunu dışa aktarma&#10;• WebSocket timeout ve bağlantı yenileme koruması&#10;• Self-contained Windows x64 EXE" Foreground="{StaticResource TextBrush}" FontSize="14" Margin="0,15,0,0" LineHeight="26"/></StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource InnerCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="AUTO TUNE" Style="{StaticResource CardLabel}"/><TextBlock Text="Upload + GPU + CPU → profil" Foreground="{StaticResource TextBrush}" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="Yayın başlamadan önce güvenli ayar hazırlığı." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border>
     <Border Grid.Column="1" Style="{StaticResource InnerCard}" Margin="8,0"><StackPanel><TextBlock Text="RECOVERY" Style="{StaticResource CardLabel}"/><TextBlock Text="Backup + Rollback" Foreground="{StaticResource TextBrush}" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="Değişiklik öncesi yerel yedek." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border>
     <Border Grid.Column="2" Style="{StaticResource InnerCard}" Margin="8,0,0,0"><StackPanel><TextBlock Text="SECURITY" Style="{StaticResource CardLabel}"/><TextBlock Text="Local-only credentials" Foreground="{StaticResource TextBrush}" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="OBS içindeki yayın anahtarı okunmaz; özel RTMP anahtarı yalnızca kullanıcı girerse uygulanır." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border>
    </Grid>
   </Grid>
  </Grid>
  <Grid Grid.Row="3" Margin="0,14,0,0"><TextBlock Text="TB OBS Auto Setup V9 One-Click Live Center • Windows x64 • Self-contained • OBS WebSocket 5.x" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock Text="NEON PROFESSIONAL MODE" Foreground="{StaticResource PurpleBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/></Grid>
 </Grid>
</Window>
