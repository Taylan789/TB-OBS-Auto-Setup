<Window x:Class="TB_OBS_AutoSetup.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="TB OBS Auto Setup V4 Ultimate"
 Width="1440" Height="900" MinWidth="1180" MinHeight="760"
 WindowStartupLocation="CenterScreen"
 Background="{StaticResource BgBrush}">
 <Grid Margin="22">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal">
    <Border Width="48" Height="48" CornerRadius="14" Background="#14261D" BorderBrush="#2B6B49" BorderThickness="1">
     <TextBlock Text="TB" Foreground="{StaticResource GreenBrush}" FontSize="18" FontWeight="Bold"
                HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <StackPanel Margin="14,0,0,0">
     <TextBlock Text="TB OBS AUTO SETUP" Foreground="{StaticResource TextBrush}" FontSize="26" FontWeight="Bold"/>
     <TextBlock Text="Ultimate streaming configuration &amp; diagnostics suite" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
    </StackPanel>
   </StackPanel>
   <StackPanel Grid.Column="1" HorizontalAlignment="Right">
    <TextBlock Text="V4 ULTIMATE" Foreground="{StaticResource GreenBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
    <TextBlock x:Name="ConnectionText" Text="● OBS BAĞLI DEĞİL" Foreground="{StaticResource MutedBrush}"
               FontSize="12" HorizontalAlignment="Right" Margin="0,4,0,0"/>
   </StackPanel>
  </Grid>

  <Grid Grid.Row="1" Margin="0,18,0,16">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
   </Grid.ColumnDefinitions>

   <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
           CornerRadius="12" Margin="0,0,7,0" Padding="13">
    <StackPanel><TextBlock Text="CPU" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
     <TextBlock x:Name="CpuCard" Text="—" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold"
                TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/></StackPanel>
   </Border>
   <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
           CornerRadius="12" Margin="7,0" Padding="13">
    <StackPanel><TextBlock Text="GPU" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
     <TextBlock x:Name="GpuCard" Text="—" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold"
                TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/></StackPanel>
   </Border>
   <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
           CornerRadius="12" Margin="7,0" Padding="13">
    <StackPanel><TextBlock Text="RAM" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
     <TextBlock x:Name="RamCard" Text="—" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
   </Border>
   <Border Grid.Column="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
           CornerRadius="12" Margin="7,0" Padding="13">
    <StackPanel><TextBlock Text="ENCODER PLAN" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
     <TextBlock x:Name="EncoderCard" Text="—" Foreground="{StaticResource GreenBrush}" FontSize="13" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel>
   </Border>
   <Border Grid.Column="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
           CornerRadius="12" Margin="7,0,0,0" Padding="13">
    <StackPanel><TextBlock Text="OBS HEALTH" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
     <TextBlock x:Name="HealthCard" Text="Bekleniyor" Foreground="{StaticResource AmberBrush}" FontSize="13" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel>
   </Border>
  </Grid>

  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="325"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

   <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
           CornerRadius="14" Padding="17" Margin="0,0,12,0">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <TextBlock Text="CONTROL CENTER" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="Bold"/>
      <TextBlock x:Name="PlanText" Text="Sistem hazır" Foreground="{StaticResource GreenBrush}" FontSize="12" Margin="0,5,0,16"/>

      <Button Content="1  •  SİSTEM ANALİZİ" Click="Analyze_Click"/>
      <Button Content="2  •  OBS'Yİ BAŞLAT" Click="LaunchObs_Click"/>
      <Button Content="3  •  OBS'YE BAĞLAN" Click="Connect_Click"/>
      <Button Content="4  •  PROFESYONEL KURULUM" Click="Optimize_Click"
              Background="#39FF88" Foreground="#07120B" BorderBrush="#39FF88"/>

      <Separator Margin="0,10"/>
      <TextBlock Text="DİAGNOSTIC" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
      <Button Content="UPLOAD HIZ TESTİ" Click="UploadTest_Click"/>
      <Button Content="OBS PERFORMANCE TESTİ (5 SN)" Click="Performance_Click"/>
      <Button Content="OBS DURUMUNU TARA" Click="Health_Click"/>
      <Button Content="REPLAY BUFFER'I BAŞLAT" Click="Replay_Click"/>

      <Separator Margin="0,10"/>
      <TextBlock Text="GERİ ALMA / YEDEK" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
      <Button Content="SON YEDEK KLASÖRÜNÜ AÇ" Click="OpenBackup_Click"/>
      <Button Content="SON YEDEĞİ GERİ YÜKLE" Click="Rollback_Click"
              Background="#21151A" Foreground="{StaticResource DangerBrush}" BorderBrush="#63303C"/>

      <Separator Margin="0,10"/>
      <TextBlock Text="OBS WEBSOCKET" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
      <TextBlock Text="Şifre" Foreground="{StaticResource TextBrush}" FontSize="12" Margin="0,7,0,4"/>
      <PasswordBox x:Name="PasswordBox"/>
      <TextBlock Text="127.0.0.1 : 4455" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0"/>

      <Separator Margin="0,16"/>
      <TextBlock Text="GÜVENLİK" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
      <TextBlock Text="Stream key ve hesap şifresi okunmaz. İşlem öncesi OBS yedeği alınır. Yedekler yalnızca bilgisayarında tutulur."
                 Foreground="{StaticResource TextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>
     </StackPanel>
    </ScrollViewer>
   </Border>

   <Grid Grid.Column="1">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="175"/></Grid.RowDefinitions>

    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="14" Padding="18">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid>
       <TextBlock Text="LIVE OPERATION LOG" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="Bold"/>
       <TextBlock Text="Automatic actions &amp; diagnostics" Foreground="{StaticResource MutedBrush}" FontSize="11"
                  HorizontalAlignment="Right"/>
      </Grid>
      <TextBox Grid.Row="1" x:Name="LogBox" Margin="0,14,0,0" IsReadOnly="True"
               VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
     </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="0,12,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

     <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
             CornerRadius="14" Padding="15" Margin="0,0,8,0">
      <StackPanel>
       <TextBlock Text="STREAM PROFILE" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
       <TextBlock Text="1080p60 • Advanced Output" Foreground="{StaticResource TextBrush}" FontWeight="Bold" Margin="0,7,0,0"/>
       <TextBlock Text="Encoder önerisi donanıma göre belirlenir." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
      </StackPanel>
     </Border>

     <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
             CornerRadius="14" Padding="15" Margin="8,0">
      <StackPanel>
       <TextBlock Text="AUDIO CHAIN" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
       <TextBlock Text="MIC • NOISE SUPPRESS • COMPRESSOR" Foreground="{StaticResource TextBrush}" FontWeight="Bold" Margin="0,7,0,0"/>
       <TextBlock Text="Varsayılan filtre zinciri uygulanmaya çalışılır." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
      </StackPanel>
     </Border>

     <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
             CornerRadius="14" Padding="15" Margin="8,0,0,0">
      <StackPanel>
       <TextBlock Text="OBS HEALTH" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
       <TextBlock x:Name="StatsText" Text="FPS — • Render lag — • Dropped —" Foreground="{StaticResource TextBrush}" FontWeight="Bold"
                  Margin="0,7,0,0" TextWrapping="Wrap"/>
       <TextBlock Text="OBS GetStats verileri" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
      </StackPanel>
     </Border>
    </Grid>
   </Grid>
  </Grid>

  <Grid Grid.Row="3" Margin="0,14,0,0">
   <TextBlock Text="TB OBS Auto Setup • Windows x64 • Self-contained • OBS WebSocket 5.x"
              Foreground="{StaticResource MutedBrush}" FontSize="11"/>
   <TextBlock Text="NEON PROFESSIONAL MODE" Foreground="{StaticResource PurpleBrush}" FontSize="11" FontWeight="Bold"
              HorizontalAlignment="Right"/>
  </Grid>
 </Grid>
</Window>