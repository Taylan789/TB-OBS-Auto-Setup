<Window x:Class="TB_OBS_AutoSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TB OBS — OBS For Everyone V28" Width="1180" Height="760" Background="#101014" Foreground="White">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left"><TextBlock Text="TB OBS" FontSize="28" FontWeight="Bold"/><TextBlock Text="OBS For Everyone • AI ile konuş, OBS yapsın" Foreground="#AFAFB8"/></StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="OBS:" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock x:Name="StatusText" Text="Bağlı değil" Foreground="#FF7070" VerticalAlignment="Center"/><Button Content="OBS'YE BAĞLAN" Click="Connect_Click" Margin="14,0,0,0" Padding="14,7"/></StackPanel>
        </DockPanel>
        <TabControl Grid.Row="1" Background="#17171D">
            <TabItem Header="🤖 TB AI">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Padding="12" Background="#1E1E26" CornerRadius="8" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="OpenAI API Key:" VerticalAlignment="Center"/><PasswordBox x:Name="ApiKeyBox" Width="330" Margin="10,0,18,0"/><TextBlock Text="Model:" VerticalAlignment="Center"/><TextBox x:Name="ModelBox" Text="gpt-6-astra" Width="150" Margin="8,0,18,0"/><CheckBox x:Name="AllowActionsBox" Content="AI işlemleri otomatik uygulasın" IsChecked="True" VerticalAlignment="Center"/></StackPanel>
                    </Border>
                    <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" Background="#0D0D11"><TextBlock x:Name="ChatText" TextWrapping="Wrap" Padding="18" FontSize="15"/></ScrollViewer>
                        <Border Grid.Row="1" Background="#1E1E26" Padding="10" Margin="0,10,0,0" CornerRadius="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="PromptBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" KeyDown="Prompt_KeyDown" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0"/><Button Grid.Column="1" Content="GÖNDER" Click="SendAi_Click" Padding="18,10" VerticalAlignment="Bottom"/></Grid></Border>
                    </Grid>
                    <TextBlock Grid.Row="2" x:Name="AiStatus" Text="Hazır. Örnek: 'PS5 yayın sahnesi oluştur ve kamerayı sağ alta koy.'" Foreground="#AFAFB8" Margin="2,8,0,0"/>
                </Grid>
            </TabItem>
            <TabItem Header="🟢 YENİ KULLANICI"><ScrollViewer><StackPanel Margin="22"><TextBlock Text="İlk yayınını kolayca hazırla" FontSize="25" FontWeight="Bold"/><TextBlock Text="Ne yapmak istediğini seç. AI istersen tüm kurulumu senin yerine yapabilir." Foreground="#B5B5BE" Margin="0,5,0,18"/><Button Content="🤖 AI ile kurulum yap" Click="FocusAi_Click" Padding="15" HorizontalAlignment="Left"/><TextBlock Text="\nTemel mantık" FontSize="20" FontWeight="Bold"/><TextBlock Text="Sahne = yayın ekranı • Kaynak = ekran/kamera/oyun gibi parça • Filtre = kaynak veya sese uygulanan işlem • Çıkış = yayın/kayıt kalitesi" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></ScrollViewer></TabItem>
            <TabItem Header="🎛 OBS KONTROL"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><Button Content="Yenile" Click="Refresh_Click" Margin="0,0,0,8"/><TextBlock Text="Sahneler" FontWeight="Bold"/><ListBox x:Name="ScenesList" SelectionChanged="Scene_Changed" Height="420"/></StackPanel><StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="Kaynaklar" FontWeight="Bold"/><ListBox x:Name="SourcesList" Height="300"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="Sahneyi Aç" Click="SetScene_Click" Margin="0,0,8,0"/><Button Content="Kaynağı Göster/Gizle" Click="ToggleSource_Click" Margin="0,0,8,0"/><Button Content="Kaynağı Sil" Click="DeleteSource_Click"/></StackPanel><TextBlock x:Name="ControlStatus" Text="OBS'ye bağlanınca burada kontrol edebilirsin." TextWrapping="Wrap" Margin="0,14,0,0"/></StackPanel></Grid></TabItem>
            <TabItem Header="📚 OBS'Yİ ÖĞREN"><ScrollViewer><TextBlock x:Name="GuideText" Text="OBS'yi öğrenmek için TB AI'ya soru sor." TextWrapping="Wrap" Padding="22" FontSize="16"/></ScrollViewer></TabItem>
        </TabControl>
        <TextBlock Grid.Row="2" x:Name="Footer" Text="TB OBS V28 • OBS WebSocket + AI Tool Calling" Foreground="#777780" Margin="2,10,0,0"/>
    </Grid>
</Window>
